// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА global-mcp.json
//
// ШАБЛОН GLOBAL CONFIGURATION: личные MCP-серверы. Файл хранится в домашней
// папке пользователя, и серверы доступны во всех проектах, которые вы
// открываете на этом компьютере.
// Документация: https://cursor.com/docs/mcp#configuration-locations
//
// В формате JSON комментариев нет, поэтому рабочий файл global-mcp.json
// оставлен чистым, а пояснения вынесены сюда. Cursor эту копию не читает.
//
// Как пользоваться:
//   1. Скопируйте global-mcp.json в домашнюю папку под именем
//      ~/.cursor/mcp.json. Если такой файл уже есть, перенесите в него
//      только нужные серверы.
//   2. Оставьте нужные серверы, замените имена, команды и адреса своими.
//   3. Сохраните файл и перезапустите Cursor.
//
// Кому виден файл. Только вам: в git он не попадает, и другие участники
// команды эти серверы не получат. Ключи доступа всё равно не записывайте
// в файл: передавайте их через переменные окружения.
//
// Как сочетается с серверами проекта. Cursor объединяет личные серверы
// и серверы проекта из .cursor/mcp.json. Если имя сервера совпадает,
// действует запись проекта.
//
// Не подключайте здесь серверы, которые нужны только одному проекту:
// для них есть шаблон project-mcp.json.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «имя сервера → настройки сервера».
  // Серверов может быть сколько угодно: локальных и удалённых.
  "mcpServers": {
    // Пример 1. Локальный сервер, программа которого лежит в вашей домашней
    // папке. Имя сервера замените своим — коротким, из латинских букв.
    "personal-local-server": {
      // [ОБЯЗАТЕЛЬНЫЙ по таблице документации] Тип подключения локального
      // сервера. В примерах документации эта строка опущена.
      "type": "stdio",

      // [ОБЯЗАТЕЛЬНЫЙ] string. Команда, которая запускает сервер: программа,
      // доступная в системном пути (PATH), или полный путь к ней.
      "command": "node",

      // [необязательный] array of string. Аргументы команды.
      "args": [
        // Путь к программе сервера. ${userHome} — ваша домашняя папка.
        // Путь от корня проекта здесь не подходит: личные серверы работают
        // во всех проектах.
        "${userHome}/mcp-servers/my-server/index.js"
      ],

      // [необязательный] object. Переменные окружения для сервера. Имя
      // и значение — строки в кавычках.
      "env": {
        // Ключ доступа не записан в файле. Вместо ${env:API_KEY} Cursor
        // подставит значение переменной окружения API_KEY вашей системы.
        "API_KEY": "${env:API_KEY}"
      }
    },

    // Пример 2. Удалённый сервер с входом через OAuth: достаточно адреса.
    // Войти в сервис можно в Cursor, в разделе Customize → MCPs.
    // Имя сервера замените своим.
    "personal-remote-server": {
      // [ОБЯЗАТЕЛЬНЫЙ] string. Адрес сервера. Возьмите его из официальной
      // документации сервера. В шаблоне — адрес-пример.
      "url": "https://mcp.example.com/mcp"

      // Если сервер проверяет доступ по ключу, добавьте настройку "headers":
      // пример — в шаблоне streamable-http-server.json.
    }
  }
}
