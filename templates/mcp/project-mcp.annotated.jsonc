// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА project-mcp.json
//
// ШАБЛОН PROJECT CONFIGURATION: MCP-серверы одного проекта. Файл хранится
// в проекте, попадает в git, и серверы получают все, кто открыл проект
// в Cursor.
// Документация: https://cursor.com/docs/mcp#configuration-locations
//
// В формате JSON комментариев нет, поэтому рабочий файл project-mcp.json
// оставлен чистым, а пояснения вынесены сюда. Cursor эту копию не читает.
//
// Как пользоваться:
//   1. Скопируйте project-mcp.json в свой проект под именем
//      .cursor/mcp.json. Если такой файл уже есть, перенесите в него только
//      нужные серверы.
//   2. Оставьте нужные серверы, замените имена, команды и адреса своими.
//   3. Сохраните файл и перезапустите Cursor. Затем откройте
//      Customize → MCPs и убедитесь, что серверы включены.
//   4. Сохраните .cursor/mcp.json в git, чтобы серверы получила вся команда.
//
// Секреты. Файл увидят все, у кого есть доступ к репозиторию, поэтому ключи
// доступа и пароли в него не записывают. Вместо значения пишут ссылку
// на переменную окружения: ${env:ИМЯ}. Каждый участник задаёт эту переменную
// на своём компьютере.
//
// Как сочетается с личными серверами. Cursor объединяет серверы проекта
// и личные серверы из ~/.cursor/mcp.json. Если имя сервера совпадает,
// действует запись проекта.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «имя сервера → настройки сервера».
  // Серверов может быть сколько угодно: локальных и удалённых.
  "mcpServers": {
    // Пример 1. Локальный сервер, программа которого лежит в самом проекте.
    // Имя сервера замените своим — коротким, из латинских букв.
    "project-local-server": {
      // [ОБЯЗАТЕЛЬНЫЙ по таблице документации] Тип подключения локального
      // сервера. В примерах документации эта строка опущена.
      "type": "stdio",

      // [ОБЯЗАТЕЛЬНЫЙ] string. Команда, которая запускает сервер. Программа
      // должна быть установлена у каждого участника команды.
      "command": "python",

      // [необязательный] array of string. Аргументы команды.
      "args": [
        // Путь к программе сервера. ${workspaceFolder} — корень проекта:
        // папка, в которой лежит .cursor/mcp.json. Так путь верен на любом
        // компьютере, куда бы ни был скопирован проект.
        "${workspaceFolder}/tools/mcp_server.py"
      ],

      // [необязательный] object. Переменные окружения для сервера. Имя
      // и значение — строки в кавычках.
      "env": {
        // Ключ доступа не записан в файле. Вместо ${env:API_KEY} Cursor
        // подставит значение переменной окружения API_KEY с компьютера
        // участника.
        "API_KEY": "${env:API_KEY}"
      }
    },

    // Пример 2. Удалённый сервер, общий для команды: записывается адресом.
    // Имя сервера замените своим.
    "project-remote-server": {
      // [ОБЯЗАТЕЛЬНЫЙ] string. Адрес сервера. Возьмите его из официальной
      // документации сервера. В шаблоне — адрес-пример.
      "url": "https://mcp.example.com/mcp",

      // [необязательный] object. Заголовки с ключом доступа. Если сервер
      // использует вход через OAuth, удалите настройку: каждый участник
      // войдёт в сервис сам, в разделе Customize → MCPs.
      "headers": {
        // Вместо ${env:MY_SERVICE_TOKEN} Cursor подставит значение
        // переменной окружения MY_SERVICE_TOKEN с компьютера участника.
        "Authorization": "Bearer ${env:MY_SERVICE_TOKEN}"
      }
    }
  }
}
