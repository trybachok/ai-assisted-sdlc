// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА streamable-http-server.json
//
// ШАБЛОН STREAMABLE HTTP SERVER: удалённый MCP-сервер с подключением
// по Streamable HTTP. Сервер развёрнут отдельно от Cursor — в интернете,
// в сети компании или на вашем компьютере, — и им могут пользоваться
// несколько человек. Cursor подключается к нему по адресу (URL) для HTTP.
// Документация: https://cursor.com/docs/mcp#how-it-works
//
// В формате JSON комментариев нет, поэтому рабочий файл
// streamable-http-server.json оставлен чистым, а пояснения вынесены сюда.
// Cursor эту копию не читает.
//
// Как пользоваться:
//   1. Перенесите запись сервера в свой mcp.json: в .cursor/mcp.json проекта
//      или в ~/.cursor/mcp.json. Если файла ещё нет, скопируйте шаблон под
//      этим именем.
//   2. Замените имя сервера и адрес данными из официальной документации
//      сервера.
//   3. Сохраните файл и перезапустите Cursor.
//
// Streamable HTTP или SSE. Оба способа записывают одинаково — настройкой
// "url". Различается только адрес: какой из них указать, сообщает владелец
// сервера. Сервер с подключением по Streamable HTTP можно подключить
// и к облачным агентам: для них это рекомендуемый способ.
//
// Безопасность. Удалённый сервер получает данные, которые передаёт ему
// агент. Подключайте только серверы, которым доверяете. Ключи доступа в файл
// не записывайте: передавайте их через переменные окружения.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «имя сервера → настройки сервера».
  "mcpServers": {
    // Имя сервера: под ним сервер виден в Cursor. Замените своим — коротким,
    // из латинских букв, например "issue-tracker".
    "remote-server": {
      // [ОБЯЗАТЕЛЬНЫЙ] string. Адрес сервера для подключения по HTTP.
      // Возьмите его из официальной документации сервера. В шаблоне —
      // адрес-пример.
      "url": "https://mcp.example.com/mcp",

      // [необязательный] object. Заголовки, которые Cursor отправляет серверу
      // с каждым запросом. Нужны, если сервер проверяет доступ по ключу.
      // Если сервер использует вход через OAuth, удалите настройку: войти
      // в сервис можно в Cursor, в разделе Customize → MCPs.
      "headers": {
        // Ключ доступа не записан в файле. Вместо ${env:MY_SERVICE_TOKEN}
        // Cursor подставит значение переменной окружения MY_SERVICE_TOKEN
        // вашей системы. Имя заголовка и слово перед ключом (здесь Bearer)
        // возьмите из документации сервера.
        "Authorization": "Bearer ${env:MY_SERVICE_TOKEN}"
      }

      // Настройки "envFile" у удалённых серверов нет: значения берут
      // из переменных окружения системы.
    }
  }
}
