// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА stdio-server.json
//
// ШАБЛОН STDIO SERVER: локальный MCP-сервер. Это программа, которую Cursor сам
// запускает на вашем компьютере и которой сам управляет. Таким сервером
// пользуется один человек — вы.
// Документация: https://cursor.com/docs/mcp#stdio-server-configuration
//
// В формате JSON комментариев нет, поэтому рабочий файл stdio-server.json
// оставлен чистым, а пояснения вынесены сюда. Cursor эту копию не читает.
//
// Как пользоваться:
//   1. Перенесите запись сервера в свой mcp.json: в .cursor/mcp.json проекта
//      или в ~/.cursor/mcp.json. Если файла ещё нет, скопируйте шаблон под
//      этим именем.
//   2. Замените имя сервера, команду и аргументы данными из официальной
//      документации сервера. Необязательные настройки, которые не нужны,
//      удалите.
//   3. Сохраните файл и перезапустите Cursor.
//
// Безопасность. Локальный сервер — программа, которая работает на вашем
// компьютере от вашего имени. Подключайте только серверы, которым доверяете.
// Ключи доступа и пароли в файл не записывайте: передавайте их через
// переменные окружения.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «имя сервера → настройки сервера».
  "mcpServers": {
    // Имя сервера: под ним сервер виден в Cursor. Замените своим — коротким,
    // из латинских букв, например "github".
    "local-server": {
      // [ОБЯЗАТЕЛЬНЫЙ по таблице документации] Тип подключения локального
      // сервера. В примерах документации эта строка опущена: Cursor 3.30
      // узнаёт локальный сервер по настройке "command".
      "type": "stdio",

      // [ОБЯЗАТЕЛЬНЫЙ] string. Команда, которая запускает сервер: программа,
      // доступная в системном пути (PATH), или полный путь к ней. Примеры
      // из документации: "npx", "node", "python", "docker".
      "command": "npx",

      // [необязательный] array of string. Аргументы команды: каждый —
      // отдельной строкой в кавычках.
      "args": [
        // Ключ программы npx: загрузить пакет, не спрашивая подтверждения.
        "-y",

        // Имя пакета сервера. Замените точным именем из официальной
        // документации сервера: npx загрузит этот пакет из интернета
        // и запустит его на вашем компьютере. Пока здесь текст в квадратных
        // скобках, сервер не запустится.
        "[имя пакета сервера]"
      ],

      // [необязательный] object. Переменные окружения для сервера: настройки
      // и ключи доступа. Имя и значение — строки в кавычках, даже если
      // значение — число.
      "env": {
        // Ключ доступа не записан в файле. Вместо ${env:API_KEY} Cursor
        // подставит значение переменной окружения API_KEY вашей системы.
        "API_KEY": "${env:API_KEY}"
      },

      // [необязательный] string. Путь к файлу с дополнительными переменными
      // окружения — строками вида ИМЯ=значение. Настройка есть только
      // у локальных серверов. ${workspaceFolder} — корень проекта.
      // Сервер получит все переменные из файла: не указывайте файл, в котором
      // есть пароли, не нужные серверу. Если файла нет, удалите строку.
      "envFile": "${workspaceFolder}/.env"
    }
  }
}
