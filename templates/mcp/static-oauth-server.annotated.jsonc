// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА static-oauth-server.json
//
// ШАБЛОН REMOTE SERVER WITH STATIC OAUTH: удалённый MCP-сервер с входом через
// OAuth, для которого Cursor использует заранее выданные данные приложения
// (Client ID и Client Secret), а не регистрирует приложение сам.
// Документация: https://cursor.com/docs/mcp#static-oauth-for-remote-servers
//
// В формате JSON комментариев нет, поэтому рабочий файл
// static-oauth-server.json оставлен чистым, а пояснения вынесены сюда.
// Cursor эту копию не читает.
//
// Когда нужен этот шаблон:
//   - владелец сервера выдаёт постоянный Client ID и, возможно, Client
//     Secret;
//   - владелец сервера требует заранее внести адрес возврата (redirect URL)
//     в список разрешённых — так делают, например, Figma и Linear;
//   - сервер не поддерживает автоматическую регистрацию приложений (OAuth 2.0
//     Dynamic Client Registration).
// В остальных случаях настройка "auth" не нужна: возьмите шаблон
// streamable-http-server.json или sse-server.json.
//
// Адреса возврата Cursor. Внесите их в настройки приложения у владельца
// сервера:
//   https://www.cursor.com/agents/mcp/oauth/callback — вход из браузера
//                                                      и из Cursor Agents
//   http://localhost:8787/callback                   — вход из приложения
//                                                      Cursor
// Если участники входят и из браузера, и из приложения, внесите оба адреса.
//
// Как пользоваться:
//   1. Получите у владельца сервера Client ID и, если он выдаётся, Client
//      Secret.
//   2. Сохраните их в переменных окружения своей системы: MCP_CLIENT_ID
//      и MCP_CLIENT_SECRET. В файл их не записывайте.
//   3. Перенесите запись сервера в свой mcp.json: в .cursor/mcp.json проекта
//      или в ~/.cursor/mcp.json. Замените имя сервера и адрес.
//   4. Сохраните файл и перезапустите Cursor.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «имя сервера → настройки сервера».
  "mcpServers": {
    // Имя сервера: под ним сервер виден в Cursor. Замените своим — коротким,
    // из латинских букв, например "figma".
    "oauth-server": {
      // [ОБЯЗАТЕЛЬНЫЙ] string. Адрес удалённого сервера. Возьмите его
      // из официальной документации сервера. В шаблоне — адрес-пример.
      // Настройка "auth" работает только у серверов, заданных через "url".
      "url": "https://mcp.example.com/mcp",

      // [ОБЯЗАТЕЛЬНЫЙ для этого типа] object. Данные приложения OAuth.
      "auth": {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Client ID, который выдал владелец сервера.
        // Вместо ${env:MCP_CLIENT_ID} Cursor подставит значение переменной
        // окружения MCP_CLIENT_ID вашей системы.
        "CLIENT_ID": "${env:MCP_CLIENT_ID}",

        // [необязательный] string. Client Secret. Нужен, только если владелец
        // сервера его выдаёт. Не записывайте секрет в файл: используйте
        // переменную окружения.
        "CLIENT_SECRET": "${env:MCP_CLIENT_SECRET}",

        // [необязательный] array of string. Права доступа (scopes), которые
        // Cursor запросит у сервера. Названия прав возьмите из документации
        // сервера; здесь — названия-примеры. Без настройки Cursor сам узнает
        // у сервера список прав. Некоторые серверы продлевают вход без
        // вашего участия, только если запрошено право вроде
        // "offline_access": тогда добавьте его в этот список.
        "scopes": [
          "read",
          "write"
        ]
      }
    }
  }
}
