// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА agent-hooks.json
//
// ШАБЛОН AGENT HOOKS: хуки, которые срабатывают во время работы агента в чате.
// Это самая большая категория: 18 событий.
// Документация: https://cursor.com/docs/hooks#hook-events
//
// В формате JSON комментариев нет, поэтому рабочий файл agent-hooks.json
// оставлен чистым, а пояснения вынесены сюда. Cursor эту копию не читает.
//
// ВАЖНО: В ШАБЛОНЕ ПОДКЛЮЧЕНЫ ВСЕ 18 СОБЫТИЙ, ЧТОБЫ ПОКАЗАТЬ ПОЛНЫЙ СПИСОК.
// В свой hooks.json переносите только нужные: каждый хук — это отдельная
// программа, которая запускается при каждом срабатывании события.
//
// Как пользоваться:
//   1. Выберите событие по описанию ниже.
//   2. Перенесите его запись в свой hooks.json: в .cursor/hooks.json проекта
//      или в ~/.cursor/hooks.json.
//   3. Скопируйте нужный скрипт из папки hooks/ и сделайте его исполняемым:
//      chmod +x .cursor/hooks/*.sh
//
// Пути записаны для проекта: от его корня. Для личных хуков
// (~/.cursor/hooks.json) замените ".cursor/hooks/" на "./hooks/".
//
// Как читать пояснения к событию:
//   «Ответ»   — что скрипт может сообщить Cursor в своём JSON-ответе.
//   «matcher» — с чем сравнивается условие запуска "matcher".
//   «Облако»  — событие не выполняется в облачных агентах.
//
// Поля, которые приходят на вход, и поля ответа перечислены в заголовках
// скриптов из папки hooks/.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] number. Версия формата файла. Используйте 1.
  "version": 1,

  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «событие → хуки». Каждое событие
  // необязательно. У одного события может быть несколько хуков.
  "hooks": {
    // -------------------------------------------------------------------------
    // ЧАТ: начало и конец
    // -------------------------------------------------------------------------

    // [необязательное событие] Создан новый чат. Cursor не ждёт ответа хука
    // и не может отменить создание чата.
    // Ответ: additional_context — текст, который агент получит в начале чата;
    // env — переменные окружения для следующих хуков этого чата.
    // matcher: не используется. Облако: не выполняется.
    "sessionStart": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/session-start-hook.sh"
      }
    ],

    // [необязательное событие] Чат завершён. Подходит для журналов и уборки
    // временных файлов. Ответ хука не используется.
    // matcher: не используется. Облако: не выполняется.
    "sessionEnd": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/observe-hook.sh"
      }
    ],

    // -------------------------------------------------------------------------
    // ЛЮБЫЕ ИНСТРУМЕНТЫ АГЕНТА
    // Инструмент — действие агента: выполнить команду, прочитать или изменить
    // файл, вызвать внешний сервис, запустить субагента.
    // -------------------------------------------------------------------------

    // [необязательное событие] Агент собирается использовать любой инструмент.
    // Ответ: permission — "allow" (разрешить) или "deny" (запретить);
    // user_message — текст для пользователя; agent_message — текст для агента;
    // updated_input — изменённые аргументы инструмента.
    // matcher: тип инструмента — Shell, Read, Write, Grep, Delete, Task,
    // а для инструментов MCP — "MCP:<имя инструмента>".
    "preToolUse": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/permission-hook.sh",

        // [необязательный] string. Запускать хук только для инструментов,
        // которые выполняют команды, изменяют и удаляют файлы.
        "matcher": "Shell|Write|Delete"
      }
    ],

    // [необязательное событие] Инструмент успешно отработал. Подходит для
    // журналов. Ответ: additional_context — текст, который агент получит
    // после результата инструмента; updated_mcp_tool_output — только для
    // инструментов MCP: заменяет результат, который увидит модель.
    // matcher: тип инструмента, как у preToolUse.
    "postToolUse": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/observe-hook.sh"
      }
    ],

    // [необязательное событие] Инструмент завершился ошибкой, не уложился
    // во время или был запрещён. Ответ: additional_context — подсказка агенту.
    // matcher: тип инструмента, как у preToolUse.
    "postToolUseFailure": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/observe-hook.sh"
      }
    ],

    // -------------------------------------------------------------------------
    // СУБАГЕНТЫ
    // -------------------------------------------------------------------------

    // [необязательное событие] Агент собирается запустить субагента.
    // Ответ: permission — "allow" или "deny" (значение "ask" считается
    // запретом); user_message — текст для пользователя при запрете.
    // matcher: тип субагента — generalPurpose, explore, shell и другие.
    "subagentStart": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/permission-hook.sh",

        // [необязательный] string. Запускать хук только для субагентов
        // этих типов.
        "matcher": "generalPurpose|explore"
      }
    ],

    // [необязательное событие] Субагент закончил работу, завершился ошибкой
    // или был остановлен. Ответ: followup_message — текст следующего
    // сообщения: субагент продолжит работу с ним. Учитывается, только если
    // субагент закончил работу успешно.
    // matcher: тип субагента, как у subagentStart.
    "subagentStop": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/stop-hook.sh",

        // [необязательный] number | null. Сколько раз подряд хук может
        // продолжить работу. По умолчанию 5, null — без ограничения.
        "loop_limit": 5
      }
    ],

    // -------------------------------------------------------------------------
    // КОМАНДЫ В ТЕРМИНАЛЕ
    // -------------------------------------------------------------------------

    // [необязательное событие] Агент собирается выполнить команду.
    // Ответ: permission — "allow", "deny" или "ask" (спросить пользователя);
    // user_message — текст для пользователя; agent_message — текст для агента.
    // matcher: текст команды.
    "beforeShellExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/permission-hook.sh",

        // [необязательный] string. Запускать хук, только если в команде есть
        // «rm -rf» или «git push».
        "matcher": "rm -rf|git push"
      }
    ],

    // [необязательное событие] Команда выполнена. Подходит для журналов:
    // на вход приходят команда, её вывод и время выполнения. Полей ответа нет.
    // matcher: текст команды.
    "afterShellExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/observe-hook.sh"
      }
    ],

    // -------------------------------------------------------------------------
    // ВНЕШНИЕ СЕРВИСЫ (MCP)
    // -------------------------------------------------------------------------

    // [необязательное событие] Агент собирается вызвать инструмент
    // MCP-сервера. Ответ: permission — "allow", "deny" или "ask";
    // user_message; agent_message.
    // matcher: в документации не указан; в Cursor 3.30 условие сравнивается
    // со значением "MCP:<имя инструмента>". Облако: не выполняется.
    "beforeMCPExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/permission-hook.sh",

        // [необязательный] boolean. false (по умолчанию) — если хук
        // не сработал, вызов выполняется. Для хуков, от которых зависит
        // безопасность, документация советует true: при сбое хука вызов
        // запрещается.
        "failClosed": false
      }
    ],

    // [необязательное событие] Инструмент MCP-сервера отработал. Подходит
    // для журналов: на вход приходят имя инструмента, его параметры
    // и результат. Полей ответа нет.
    // matcher: как у beforeMCPExecution. Облако: не выполняется.
    "afterMCPExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/observe-hook.sh"
      }
    ],

    // -------------------------------------------------------------------------
    // ФАЙЛЫ
    // -------------------------------------------------------------------------

    // [необязательное событие] Агент собирается прочитать файл. Хук может
    // не дать отправить модели файл с секретами.
    // Ответ: permission — "allow" или "deny" (значение "ask" здесь
    // не работает); user_message — текст для пользователя при запрете.
    // matcher: значение "Read".
    "beforeReadFile": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/permission-hook.sh"
      }
    ],

    // [необязательное событие] Агент изменил файл. Подходит для
    // автоматического форматирования и учёта изменений. Полей ответа нет.
    // matcher: значение "Write".
    "afterFileEdit": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/observe-hook.sh"
      }
    ],

    // -------------------------------------------------------------------------
    // ЗАПРОС ПОЛЬЗОВАТЕЛЯ И ОТВЕТ АГЕНТА
    // -------------------------------------------------------------------------

    // [необязательное событие] Пользователь нажал «отправить», но запрос ещё
    // не ушёл. Ответ: continue — true (отправить) или false (не отправлять);
    // user_message — текст для пользователя, если запрос не отправлен.
    // matcher: значение "UserPromptSubmit".
    "beforeSubmitPrompt": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/before-submit-prompt-hook.sh"
      }
    ],

    // [необязательное событие] Чат стал слишком длинным, и Cursor собирается
    // сжать его в краткое изложение. Хук только наблюдает: отменить или
    // изменить сжатие он не может.
    // Ответ: user_message — сообщение пользователю.
    // matcher: не используется.
    "preCompact": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/observe-hook.sh"
      }
    ],

    // [необязательное событие] Агент закончил работу над запросом.
    // Ответ: followup_message — текст следующего сообщения: Cursor отправит
    // его сам, и агент продолжит работу. Так можно, например, попросить
    // запустить тесты.
    // matcher: значение "Stop".
    "stop": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/stop-hook.sh",

        // [необязательный] number | null. Сколько раз подряд хук может
        // продолжить работу. По умолчанию 5, null — без ограничения.
        "loop_limit": 5
      }
    ],

    // [необязательное событие] Агент написал ответ. Подходит для журналов:
    // на вход приходит текст ответа. Полей ответа нет.
    // matcher: значение "AgentResponse".
    "afterAgentResponse": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/observe-hook.sh"
      }
    ],

    // [необязательное событие] Агент закончил блок размышлений. Подходит для
    // наблюдения за ходом рассуждений: на вход приходит их текст.
    // Полей ответа нет.
    // matcher: значение "AgentThought".
    "afterAgentThought": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/observe-hook.sh"
      }
    ]
  }
}
