// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА user-hooks.json
//
// ШАБЛОН USER HOOKS: личные хуки. Файл хранится в домашней папке пользователя
// и действует во всех проектах, которые вы открываете на этом компьютере.
// Документация: https://cursor.com/docs/hooks#quickstart
//
// В формате JSON комментариев нет, поэтому рабочий файл user-hooks.json
// оставлен чистым, а пояснения вынесены сюда. Cursor эту копию не читает.
//
// Как пользоваться:
//   1. Скопируйте user-hooks.json в домашнюю папку под именем
//      ~/.cursor/hooks.json. Если такой файл уже есть, перенесите в него
//      только нужные события.
//   2. Скопируйте нужные скрипты из папки hooks/ в папку ~/.cursor/hooks/
//      и сделайте их исполняемыми: chmod +x ~/.cursor/hooks/*.sh
//   3. Оставьте нужные события, подключите свои скрипты.
//
// Пути. Личные хуки запускаются из папки ~/.cursor/, поэтому путь к скрипту
// пишут от неё: "./hooks/имя.sh".
//
// Где работают. Только на вашем компьютере. Облачные агенты личные хуки
// не выполняют: у них нет доступа к вашей домашней папке.
// Не пишите в личных хуках то, что верно только для одного проекта.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] number. Версия формата файла. Используйте 1.
  "version": 1,

  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «событие → хуки». Указывайте только нужные
  // события. У одного события может быть несколько хуков: выполнятся все.
  "hooks": {
    // Событие: создан новый чат. Хук может добавить в чат сведения, например
    // ваши личные предпочтения. Отменить создание чата хук не может.
    "sessionStart": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту от папки ~/.cursor/.
        "command": "./hooks/session-start-hook.sh"
      }
    ],

    // Событие: вы нажали «отправить», но запрос ещё не ушёл. Хук может
    // проверить запрос, например на пароли и ключи, и не отправить его.
    "beforeSubmitPrompt": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту от папки ~/.cursor/.
        "command": "./hooks/before-submit-prompt-hook.sh"
      }
    ]
  }
}
