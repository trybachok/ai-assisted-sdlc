// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА tab-hooks.json
//
// ШАБЛОН TAB HOOKS: хуки для автодополнения Tab — подсказок, которые Cursor
// предлагает прямо в редакторе, пока вы печатаете. К агенту в чате эти хуки
// не относятся: для него есть Agent hooks.
// Документация: https://cursor.com/docs/hooks#hook-categories
//
// В формате JSON комментариев нет, поэтому рабочий файл tab-hooks.json
// оставлен чистым, а пояснения вынесены сюда. Cursor эту копию не читает.
//
// Как пользоваться:
//   1. Перенесите нужные события в свой hooks.json: в .cursor/hooks.json
//      проекта или в ~/.cursor/hooks.json.
//   2. Скопируйте скрипты из папки hooks/ и сделайте их исполняемыми:
//      chmod +x .cursor/hooks/*.sh
//
// Пути записаны для проекта: от его корня. Для личных хуков
// (~/.cursor/hooks.json) замените ".cursor/hooks/" на "./hooks/".
//
// В облачных агентах Tab hooks не выполняются: автодополнения там нет.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] number. Версия формата файла. Используйте 1.
  "version": 1,

  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «событие → хуки».
  "hooks": {
    // Событие: Tab собирается прочитать файл. Хук может запретить чтение,
    // например файла с паролями. На вход приходят путь к файлу (file_path)
    // и его содержимое (content). Ответ: "permission" со значением "allow"
    // или "deny". Значение "ask" здесь не работает.
    // Условие matcher сравнивается со значением "TabRead".
    "beforeTabFileRead": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/permission-hook.sh"
      }
    ],

    // Событие: Tab изменил файл. Подходит для форматирования и учёта
    // изменений. На вход приходят путь к файлу и список правок: для каждой —
    // место в файле (range), строка до правки (old_line) и после (new_line).
    // Полей ответа нет. Условие matcher сравнивается со значением "TabWrite".
    "afterTabFileEdit": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/observe-hook.sh"
      }
    ]
  }
}
