// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА enterprise-hooks.json
//
// ШАБЛОН ENTERPRISE HOOKS: хуки организации. Файл лежит в системной папке
// компьютера и действует для всех его пользователей во всех проектах. Файлы
// на компьютеры сотрудников раздаёт IT-отдел через систему управления
// устройствами (MDM).
// Документация: https://cursor.com/docs/hooks#mdm-distribution
//
// В формате JSON комментариев нет, поэтому рабочий файл enterprise-hooks.json
// оставлен чистым, а пояснения вынесены сюда. Cursor эту копию не читает.
//
// Куда поместить файл (под именем hooks.json):
//   macOS:      /Library/Application Support/Cursor/hooks.json
//   Linux, WSL: /etc/cursor/hooks.json
//   Windows:    C:\ProgramData\Cursor\hooks.json
//
// Как пользоваться:
//   1. Оставьте нужные события, подключите свои скрипты.
//   2. Передайте hooks.json и скрипты IT-отделу. Скрипты кладут в папку hooks
//      рядом с файлом hooks.json и делают исполняемыми.
//   3. Cursor файлы не раздаёт и не обновляет: за это отвечает IT-отдел.
//
// Пути. Хуки организации запускаются из папки, в которой лежит hooks.json,
// поэтому путь к скрипту пишут от неё: "./hooks/имя.sh".
//
// Как сочетаются с другими хуками. Cursor выполняет все подходящие хуки всех
// уровней: организации, команды, проекта и пользователя. Если они отвечают
// по-разному, побеждает самый строгий ответ: запрет главнее вопроса, вопрос
// главнее разрешения — на каком бы уровне ни был хук. Поэтому хук проекта
// или личный хук не может отменить запрет, который вернул хук организации.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] number. Версия формата файла. Используйте 1.
  "version": 1,

  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «событие → хуки». Указывайте только нужные
  // события. У одного события может быть несколько хуков: выполнятся все.
  "hooks": {
    // Событие: агент собирается выполнить команду в терминале. Хук может
    // разрешить команду, запретить её или спросить пользователя.
    "beforeShellExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту от папки с файлом hooks.json.
        "command": "./hooks/permission-hook.sh",

        // [необязательный] number. Сколько секунд ждать ответа скрипта.
        "timeout": 30,

        // [необязательный] boolean. true — если хук не сработал (скрипт
        // не найден, упал или не ответил вовремя), действие запрещается.
        // Так правило безопасности нельзя обойти, сломав хук. Проверьте, что
        // скрипт установлен на каждом компьютере: иначе запрещены будут все
        // команды. false (по умолчанию) — при сбое хука действие выполняется.
        "failClosed": true
      }
    ],

    // Событие: агент собирается вызвать инструмент MCP-сервера (внешнего
    // сервиса). Хук может разрешить вызов, запретить его или спросить
    // пользователя.
    "beforeMCPExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту от папки с файлом hooks.json.
        "command": "./hooks/permission-hook.sh",

        // [необязательный] number. Сколько секунд ждать ответа скрипта.
        "timeout": 30,

        // [необязательный] boolean. Для хуков beforeMCPExecution, от которых
        // зависит безопасность, документация советует значение true.
        "failClosed": true
      }
    ]
  }
}
