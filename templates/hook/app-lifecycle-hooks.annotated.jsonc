// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА app-lifecycle-hooks.json
//
// ШАБЛОН APP LIFECYCLE HOOKS: хук срабатывает не в чате, а когда Cursor
// открывает проект. В этой категории одно событие — workspaceOpen.
// Документация: https://cursor.com/docs/hooks#workspaceopen
//
// В формате JSON комментариев нет, поэтому рабочий файл
// app-lifecycle-hooks.json оставлен чистым, а пояснения вынесены сюда.
// Cursor эту копию не читает.
//
// Как пользоваться:
//   1. Перенесите событие в свой hooks.json: в .cursor/hooks.json проекта
//      или в ~/.cursor/hooks.json.
//   2. Скопируйте скрипт hooks/workspace-open-hook.sh и сделайте его
//      исполняемым: chmod +x .cursor/hooks/workspace-open-hook.sh
//   3. Впишите в скрипт свои папки с плагинами.
//
// Пути записаны для проекта: от его корня. Для личных хуков
// (~/.cursor/hooks.json) замените ".cursor/hooks/" на "./hooks/".
//
// Хук работает в приложении Cursor и в Cursor CLI. В облачных агентах
// не выполняется.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] number. Версия формата файла. Используйте 1.
  "version": 1,

  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «событие → хуки».
  "hooks": {
    // Событие: Cursor открыл проект. Срабатывает также при каждом изменении
    // набора папок проекта; если в окне нет ни одной папки, не срабатывает.
    // На вход приходят версия Cursor, папки проекта (workspace_roots)
    // и e-mail пользователя; сведений о чате нет.
    // Ответ: "pluginPaths" — список абсолютных путей к папкам плагинов,
    // которые Cursor загрузит для открытого проекта.
    // Условие matcher для этого события не используется.
    "workspaceOpen": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/workspace-open-hook.sh"
      }
    ]
  }
}
