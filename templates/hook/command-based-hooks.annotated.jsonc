// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА command-based-hooks.json
//
// ШАБЛОН COMMAND-BASED HOOKS: хук запускает скрипт. Это тип выполнения
// по умолчанию. Шаблон показывает все настройки такого хука.
// Документация: https://cursor.com/docs/hooks#command-based-hooks
//
// В формате JSON комментариев нет, поэтому рабочий файл
// command-based-hooks.json оставлен чистым, а пояснения вынесены сюда.
// Cursor эту копию не читает.
//
// Как работает хук-скрипт:
//   - Cursor запускает скрипт и передаёт ему сведения о событии в формате
//     JSON через стандартный ввод (stdin).
//   - Скрипт печатает ответ в формате JSON в стандартный вывод (stdout).
//     Кроме ответа, в stdout ничего попадать не должно.
//   - Код выхода 0 — успех, Cursor использует ответ. Код 2 — запретить
//     действие. Любой другой код — хук считается упавшим, и действие
//     выполняется, если не задано "failClosed": true.
//
// Как пользоваться:
//   1. Перенесите нужные записи в свой hooks.json: в .cursor/hooks.json
//      проекта или в ~/.cursor/hooks.json.
//   2. Скопируйте скрипты из папки hooks/ и сделайте их исполняемыми:
//      chmod +x .cursor/hooks/*.sh
//
// Пути записаны для проекта: от его корня. Для личных хуков
// (~/.cursor/hooks.json) замените ".cursor/hooks/" на "./hooks/".
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] number. Версия формата файла. Используйте 1.
  "version": 1,

  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «событие → хуки».
  "hooks": {
    // Событие: агент собирается выполнить команду в терминале.
    // Запись показывает настройки, которые подходят любому событию.
    "beforeShellExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/permission-hook.sh",

        // [необязательный] "command" | "prompt". Тип выполнения. "command" —
        // значение по умолчанию: строку можно не писать.
        "type": "command",

        // [необязательный] number. Сколько секунд ждать ответа скрипта.
        // Без этой строки действует значение Cursor по умолчанию.
        "timeout": 30,

        // [необязательный] string. Условие запуска — регулярное выражение.
        // Для beforeShellExecution оно сравнивается с текстом команды: здесь
        // хук запускается, только если в команде есть «curl» или «wget».
        // Пустая строка или "*" — запускать всегда.
        "matcher": "curl|wget",

        // [необязательный] boolean. false (по умолчанию) — если хук не
        // сработал, действие выполняется. true — действие запрещается.
        "failClosed": false
      }
    ],

    // Событие: агент закончил работу над запросом. Хук может продолжить
    // работу: вернуть текст следующего сообщения в поле followup_message.
    "stop": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или команда оболочки.
        "command": ".cursor/hooks/stop-hook.sh",

        // [необязательный] number | null. Только для stop и subagentStop:
        // сколько раз подряд хук может продолжить работу. По умолчанию 5,
        // null — без ограничения.
        "loop_limit": 5
      }
    ]
  }
}
