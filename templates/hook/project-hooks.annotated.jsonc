// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА project-hooks.json
//
// ШАБЛОН PROJECT HOOKS: хуки одного проекта. Файл хранится в проекте, попадает
// в git и действует у всех, кто открыл проект в Cursor.
// Документация: https://cursor.com/docs/hooks#project-hooks-version-control
//
// В формате JSON комментариев нет, поэтому рабочий файл project-hooks.json
// оставлен чистым, а пояснения вынесены сюда. Cursor эту копию не читает.
//
// Как пользоваться:
//   1. Скопируйте project-hooks.json в свой проект под именем
//      .cursor/hooks.json.
//   2. Скопируйте нужные скрипты из папки hooks/ в папку .cursor/hooks/ проекта
//      и сделайте их исполняемыми: chmod +x .cursor/hooks/*.sh
//   3. Оставьте нужные события, подключите свои скрипты и условия.
//   4. Сохраните .cursor/hooks.json и .cursor/hooks/ в git.
//
// Пути. Хуки проекта запускаются из корня проекта, поэтому путь к скрипту
// пишут от корня: ".cursor/hooks/имя.sh". Путь "./hooks/имя.sh" не подойдёт.
//
// Где работают. В приложении Cursor — в проекте, которому вы доверяете
// (trusted workspace). Облачные агенты тоже выполняют хуки проекта, но только
// Command-based hooks и не все события: список — в README.md.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] number. Версия формата файла. Используйте 1.
  "version": 1,

  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «событие → хуки». Указывайте только нужные
  // события. У одного события может быть несколько хуков: выполнятся все.
  "hooks": {
    // Событие: агент собирается выполнить команду в терминале. Хук может
    // разрешить команду, запретить её или спросить пользователя.
    "beforeShellExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту от корня проекта.
        "command": ".cursor/hooks/permission-hook.sh",

        // [необязательный] string. Условие запуска — регулярное выражение.
        // Здесь хук запускается, только если в тексте команды есть «rm -rf»
        // или «git push». Без этой строки хук запускается для каждой команды.
        "matcher": "rm -rf|git push"
      }
    ],

    // Событие: агент изменил файл. Подходит для автоматического
    // форматирования и для учёта изменений. Запретить правку хук не может.
    "afterFileEdit": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту от корня проекта.
        "command": ".cursor/hooks/observe-hook.sh"
      }
    ]
  }
}
