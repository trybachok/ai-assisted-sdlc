// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА prompt-based-hooks.json
//
// ШАБЛОН PROMPT-BASED HOOKS: вместо скрипта хук содержит условие, записанное
// обычными словами. Его проверяет быстрая AI-модель и отвечает, выполнено ли
// условие. Удобно, когда правило проще описать, чем запрограммировать.
// Документация: https://cursor.com/docs/hooks#prompt-based-hooks
//
// В формате JSON комментариев нет, поэтому рабочий файл
// prompt-based-hooks.json оставлен чистым, а пояснения вынесены сюда.
// Cursor эту копию не читает.
//
// Как работает хук-условие:
//   - Cursor отправляет модели текст из "prompt" и сведения о событии.
//   - Модель отвечает: ok — условие выполнено, действие разрешается; иначе
//     действие запрещается, а пользователь видит причину.
//
// Как пользоваться:
//   1. Перенесите запись в свой hooks.json: в .cursor/hooks.json проекта
//      или в ~/.cursor/hooks.json. Скрипты для такого хука не нужны.
//   2. Замените текст условия своим.
//
// Ограничения:
//   - Модель может ошибаться. Для строгих правил, которые должны срабатывать
//     одинаково каждый раз, используйте Command-based hooks.
//   - Облачные агенты выполняют только Command-based hooks. В плагинах хуки
//     этого типа тоже не работают.
//   - Не используйте в тексте две косые черты подряд, например в адресах
//     сайтов: Cursor может принять их за начало комментария.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] number. Версия формата файла. Используйте 1.
  "version": 1,

  // [ОБЯЗАТЕЛЬНЫЙ] object. Список «событие → хуки».
  "hooks": {
    // Событие: агент собирается выполнить команду в терминале. Тип подходит
    // событиям, которые могут запретить действие: beforeShellExecution,
    // beforeMCPExecution, beforeReadFile, preToolUse, subagentStart,
    // beforeSubmitPrompt.
    "beforeShellExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ для этого типа] Значение "prompt" включает проверку
        // условия моделью. Без этой строки Cursor ждёт скрипт в "command".
        "type": "prompt",

        // [ОБЯЗАТЕЛЬНЫЙ для этого типа] string. Условие обычными словами.
        // Вместо $ARGUMENTS Cursor подставит сведения о событии в формате
        // JSON. Если $ARGUMENTS в тексте нет, сведения добавятся в конец.
        "prompt": "Проверь команду перед запуском. Разрешай только команды, которые ничего не изменяют и не удаляют. Данные о команде: $ARGUMENTS",

        // [необязательный] number. Сколько секунд ждать ответа модели.
        "timeout": 10

        // Другие необязательные настройки:
        //   "model"       ID модели вместо быстрой модели по умолчанию.
        //   "matcher"     условие запуска, как у Command-based hooks.
        //   "failClosed"  true — запретить действие, если хук не сработал.
      }
    ]
  }
}
