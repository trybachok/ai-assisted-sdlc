// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА mcp.json
//
// Рабочая конфигурация лежит рядом (mcp.json, без комментариев), здесь — те же
// параметры с пояснениями. Cursor этот файл не читает; перед публикацией его
// можно удалить.
//
// Документация:
//   https://cursor.com/docs/reference/plugins#mcp-servers
//   https://cursor.com/docs/mcp
//
// Файл mcp.json в корне плагина обнаруживается автоматически. Сервер из плагина
// показывается с префиксом "plugin-<имя плагина>-<имя сервера>", например
// "plugin-my-plugin-postgres".
//
// -----------------------------------------------------------------------------
// ПОДСТАНОВКИ В ЗНАЧЕНИЯХ
// -----------------------------------------------------------------------------
//   ${ИМЯ}                  Переменная плагина. Имя должно быть объявлено в поле
//                           variables файла plugin.json; значение задаётся в
//                           дашборде (Plugins → Configure). Секреты в репозиторий
//                           не кладите — только плейсхолдеры.
//   ${CURSOR_PLUGIN_ROOT}   Папка установки плагина. Раскрывается в command,
//                           args, значениях env и в cwd. Переменные стандарта
//                           Agent Plugins ${PLUGIN_ROOT} и ${PLUGIN_DATA} Cursor
//                           НЕ раскрывает.
//   ${env:ИМЯ}              Переменная окружения системы.
//   ${userHome}, ${workspaceFolder}, ${workspaceFolderBasename},
//   ${pathSeparator}, ${/}  Домашняя папка, корень проекта, имя корня проекта,
//                           разделитель пути.
//   Подстановки ${env:...} и ${workspaceFolder}-подобные Cursor разрешает
//   в полях command, args, env, url и headers.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] object. Соответствие «имя сервера → конфигурация сервера».
  // Имя сервера — произвольный ключ. Сервер может быть локальным (задан
  // command) или удалённым (задан url); Cursor Plugin определяет транспорт
  // по наличию command или url.
  "mcpServers": {
    // =========================================================================
    // ПРИМЕР 1. Локальный сервер (транспорт stdio): Cursor сам запускает процесс.
    // =========================================================================
    "postgres": {
      // Тип подключения. Для stdio-сервера таблица в docs/mcp помечает поле
      // обязательным; в формате Cursor Plugin транспорт выводится из
      // command/url, поэтому в плагине поле [необязательное]. В стандарте
      // Agent Plugins (корневой plugin.json) каждый сервер объявляет транспорт.
      "type": "stdio",

      // [ОБЯЗАТЕЛЬНЫЙ для stdio] string. Команда запуска сервера: исполняемый
      // файл из PATH либо полный путь (например, "npx", "node", "python",
      // "docker").
      "command": "npx",

      // [необязательный] array of string. Аргументы команды.
      "args": ["-y", "@modelcontextprotocol/server-postgres"],

      // [необязательный] object. Переменные окружения процесса сервера
      // (ключ и значение — строки).
      "env": {
        // Произвольные пары «переменная → значение». Здесь значения — это
        // плейсхолдеры переменных плагина из plugin.json.
        // Строка подключения из обязательной переменной плагина POSTGRES_URL.
        "POSTGRES_CONNECTION_STRING": "${POSTGRES_URL}",
        // Лимит строк из переменной плагина MAX_RESULTS.
        "MAX_RESULTS": "${MAX_RESULTS}",
        // Список проектов из переменной плагина ALLOWED_PROJECTS.
        "ALLOWED_PROJECTS": "${ALLOWED_PROJECTS}"
      },

      // [необязательный] string. Путь к файлу с дополнительными переменными
      // окружения (примеры из документации: ".env", "${workspaceFolder}/.env").
      // Доступен ТОЛЬКО для stdio-серверов. Если такого файла у пользователей
      // плагина нет, удалите параметр.
      "envFile": ".env",

      // [необязательный] string. Рабочая папка процесса сервера.
      "cwd": "${CURSOR_PLUGIN_ROOT}"
    },

    // =========================================================================
    // ПРИМЕР 2. Удалённый сервер (Streamable HTTP или SSE) с токеном в заголовке.
    // =========================================================================
    "example-api": {
      // [ОБЯЗАТЕЛЬНЫЙ для удалённого сервера] string. URL эндпоинта MCP.
      "url": "https://mcp.example.com/mcp",

      // [необязательный] object. HTTP-заголовки, отправляемые серверу.
      "headers": {
        // Произвольные пары «заголовок → значение».
        // Токен из обязательной переменной плагина API_TOKEN.
        "Authorization": "Bearer ${API_TOKEN}",
        // Регион из переменной плагина API_REGION.
        "X-Api-Region": "${API_REGION}",
        // Версия API из переменной плагина API_VERSION.
        "X-Api-Version": "${API_VERSION}"
      }
    },

    // =========================================================================
    // ПРИМЕР 3. Удалённый сервер со статическими учётными данными OAuth.
    // Нужен, когда провайдер выдаёт фиксированный Client ID, требует заранее
    // зарегистрировать redirect URL или не поддерживает динамическую регистрацию
    // клиентов. Redirect URL, которые нужно разрешить у провайдера:
    //   https://www.cursor.com/agents/mcp/oauth/callback  (веб и Cursor Agents)
    //   http://localhost:8787/callback                    (десктопное приложение)
    // =========================================================================
    "example-oauth": {
      // [ОБЯЗАТЕЛЬНЫЙ для удалённого сервера] string. URL эндпоинта MCP.
      "url": "https://api.example.com/mcp",

      // [необязательный] object. Статические учётные данные OAuth. Только для
      // серверов, заданных через url.
      "auth": {
        // [ОБЯЗАТЕЛЬНЫЙ, если указан auth] string. OAuth 2.0 Client ID
        // от провайдера MCP.
        "CLIENT_ID": "${env:MCP_CLIENT_ID}",
        // [необязательный] string. OAuth 2.0 Client Secret — если провайдер
        // использует конфиденциальных клиентов. Не записывайте секрет в файл
        // напрямую: используйте подстановку.
        "CLIENT_SECRET": "${env:MCP_CLIENT_SECRET}",
        // [необязательный] array of string. Запрашиваемые OAuth-scopes. Если не
        // указаны, Cursor возьмёт scopes_supported из
        // /.well-known/oauth-authorization-server.
        "scopes": ["read", "write"]
      }
    }
  }
}
