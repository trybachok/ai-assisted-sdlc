// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА .cursor-plugin/plugin.json
//
// Cursor читает plugin.json как строгий JSON, комментарии в нём недопустимы.
// Поэтому рабочий манифест лежит рядом (plugin.json), а здесь — те же параметры
// с пояснением к каждому. Cursor этот файл не читает; перед публикацией его
// можно удалить.
//
// Документация: https://cursor.com/docs/reference/plugins#cursor-plugin-manifest
//
// Общие правила для всех путей в манифесте: только относительные, от корня
// плагина, без ".." и без абсолютных путей.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] string. Идентификатор плагина — единственное обязательное
  // поле манифеста. Строчные буквы, kebab-case: допустимы буквы, цифры, дефисы
  // и точки; начинается и заканчивается буквой или цифрой.
  // Примеры: "my-plugin", "prompts.chat". Для маркетплейса должен быть уникальным.
  "name": "my-plugin",

  // [необязательный] string. Краткое описание плагина. Для публикации в
  // маркетплейсе должно ясно объяснять назначение плагина.
  "description": "Краткое описание того, что делает плагин",

  // [необязательный] string. Версия в формате semver (например, "1.0.0").
  "version": "1.0.0",

  // [необязательный] object. Сведения об авторе.
  "author": {
    // [ОБЯЗАТЕЛЬНЫЙ, если указан объект author] string. Имя автора или организации.
    "name": "Ваше Имя",
    // [необязательный] string. Контактный e-mail автора.
    "email": "you@example.com"
  },

  // [необязательный] string. URL домашней страницы плагина.
  "homepage": "https://example.com/my-plugin",

  // [необязательный] string. URL репозитория плагина.
  "repository": "https://github.com/your-org/my-plugin",

  // [необязательный] string. Идентификатор лицензии (например, "MIT").
  "license": "MIT",

  // [необязательный] array of string. Теги для поиска и категоризации.
  "keywords": ["cursor", "plugin", "template"],

  // [необязательный] string. Логотип: относительный путь к файлу в репозитории
  // (предпочтительно) или абсолютный URL (http:// или https://). Относительный
  // путь превращается в ссылку raw.githubusercontent.com по репозиторию и SHA
  // коммита, поэтому файл логотипа должен быть закоммичен.
  "logo": "assets/logo.svg",

  // ---------------------------------------------------------------------------
  // ПУТИ К КОМПОНЕНТАМ
  //
  // Все шесть полей ниже необязательны. Если поле НЕ указано, Cursor сам находит
  // компоненты в папке по умолчанию. Если поле указано, оно ЗАМЕНЯЕТ поиск по
  // умолчанию: стандартная папка дополнительно не сканируется.
  //
  // В шаблоне указаны значения, совпадающие с папками по умолчанию, чтобы
  // показать все параметры. Если структура папок стандартная, эти шесть полей
  // можно удалить целиком.
  // ---------------------------------------------------------------------------

  // [необязательный] string | array of string. Путь(и) к файлам или папкам правил.
  // По умолчанию: rules/ — все файлы .md, .mdc, .markdown.
  "rules": "./rules/",

  // [необязательный] string | array of string. Путь(и) к файлам или папкам агентов.
  // По умолчанию: agents/ — все файлы .md, .mdc, .markdown.
  "agents": "./agents/",

  // [необязательный] string | array of string. Путь(и) к папкам навыков.
  // По умолчанию: skills/ — каждая подпапка, содержащая SKILL.md.
  // Если нет ни папки skills/, ни этого поля, файл SKILL.md в корне плагина
  // считается единственным навыком плагина.
  "skills": "./skills/",

  // [необязательный] string | array of string. Путь(и) к файлам или папкам команд.
  // По умолчанию: commands/ — все файлы .md, .mdc, .markdown, .txt.
  "commands": "./commands/",

  // [необязательный] string | object. Путь к файлу конфигурации хуков ЛИБО сама
  // конфигурация хуков прямо в манифесте (тот же формат, что в hooks/hooks.json).
  // По умолчанию: hooks/hooks.json.
  "hooks": "./hooks/hooks.json",

  // [необязательный] string | object | array. Путь к файлу конфигурации MCP,
  // встроенная конфигурация MCP-серверов либо массив из путей и/или объектов.
  // Переопределяет стандартное обнаружение mcp.json в корне плагина. Указывайте
  // только при нестандартном пути или встроенной конфигурации.
  "mcpServers": "./mcp.json",

  // [необязательный] object. JSON Schema, объявляющая ИМЕНА (а также типы и
  // описания) настроек, которые задаёт пользователь: токены, строки подключения
  // и т. п. Сами значения в плагине не хранятся: их задают в дашборде
  // (Plugins → Configure). Значения подставляются в плейсхолдеры вида ${ИМЯ}
  // в mcp.json и другой конфигурации плагина.
  //
  // Секреты в репозиторий плагина не кладите. Каждый ${ИМЯ} из mcp.json должен
  // быть объявлен здесь (пункт чек-листа публикации).
  //
  // Принимается только фиксированный набор ключевых слов JSON Schema:
  // type, title, description, default, enum, const, properties, required, items
  // и распространённые ограничения длины и числовых значений. Документация не
  // перечисляет эти ограничения поимённо; в шаблоне использованы minLength,
  // maxLength, minimum, maximum.
  "variables": {
    // [ОБЯЗАТЕЛЬНЫЙ, если указан variables] Верхний уровень схемы обязан иметь
    // вид { "type": "object", "properties": { ... } }.
    "type": "object",

    // [ОБЯЗАТЕЛЬНЫЙ, если указан variables] object. Объявления переменных:
    // ключ — имя переменной (оно же имя плейсхолдера ${ИМЯ}), значение — её схема.
    "properties": {
      // Пример строковой переменной-секрета с ограничением длины.
      "API_TOKEN": {
        // [необязательный] Тип значения: string, number, integer, boolean,
        // object, array, null.
        "type": "string",
        // [необязательный] string. Заголовок поля в форме настройки плагина.
        "title": "API-токен",
        // [необязательный] string. Пояснение к полю для того, кто настраивает плагин.
        "description": "Bearer-токен для HTTP MCP-сервера example-api",
        // [необязательный] integer >= 0. Минимальная длина строки.
        "minLength": 1,
        // [необязательный] integer >= 0. Максимальная длина строки
        // (не меньше minLength).
        "maxLength": 512
      },

      // Пример минимального объявления: только тип, заголовок и описание.
      "POSTGRES_URL": {
        // [необязательный] Тип значения.
        "type": "string",
        // [необязательный] Заголовок поля.
        "title": "Строка подключения к PostgreSQL",
        // [необязательный] Пояснение к полю.
        "description": "Например: postgresql://user:password@host:5432/dbname"
      },

      // Пример переменной с выбором из списка и значением по умолчанию.
      "API_REGION": {
        // [необязательный] Тип значения.
        "type": "string",
        // [необязательный] Заголовок поля.
        "title": "Регион API",
        // [необязательный] Пояснение к полю.
        "description": "Регион, в который MCP-сервер отправляет запросы",
        // [необязательный] непустой array. Закрытый список допустимых значений.
        "enum": ["eu", "us"],
        // [необязательный] Значение по умолчанию, если пользователь не задал своё.
        "default": "eu"
      },

      // Пример переменной с единственным допустимым значением.
      "API_VERSION": {
        // [необязательный] Тип значения.
        "type": "string",
        // [необязательный] Заголовок поля.
        "title": "Версия API",
        // [необязательный] Пояснение к полю.
        "description": "Фиксированная версия API, с которой совместим плагин",
        // [необязательный] Единственное допустимое значение переменной.
        "const": "v1",
        // [необязательный] Значение по умолчанию.
        "default": "v1"
      },

      // Пример числовой переменной с границами.
      "MAX_RESULTS": {
        // [необязательный] Тип значения.
        "type": "integer",
        // [необязательный] Заголовок поля.
        "title": "Максимум результатов",
        // [необязательный] Пояснение к полю.
        "description": "Сколько строк MCP-сервер возвращает за один запрос",
        // [необязательный] Значение по умолчанию.
        "default": 50,
        // [необязательный] number. Минимально допустимое значение.
        "minimum": 1,
        // [необязательный] number. Максимально допустимое значение
        // (не меньше minimum).
        "maximum": 500
      },

      // Пример переменной-массива.
      "ALLOWED_PROJECTS": {
        // [необязательный] Тип значения.
        "type": "array",
        // [необязательный] Заголовок поля.
        "title": "Разрешённые проекты",
        // [необязательный] Пояснение к полю.
        "description": "Список проектов, с которыми MCP-серверу разрешено работать",
        // [необязательный] object. Схема элементов массива (те же ключевые слова).
        "items": {
          // [необязательный] Тип каждого элемента массива.
          "type": "string"
        },
        // [необязательный] Значение по умолчанию.
        "default": []
      }
    },

    // [необязательный] array of string. Имена переменных, без которых плагин не
    // работает. Каждое имя должно быть объявлено в properties.
    "required": ["API_TOKEN", "POSTGRES_URL"]
  }
}
