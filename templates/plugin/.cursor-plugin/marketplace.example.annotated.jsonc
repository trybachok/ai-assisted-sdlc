// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА marketplace.example.json
//
// ЭТОТ ФАЙЛ НЕ ЯВЛЯЕТСЯ ЧАСТЬЮ ОДИНОЧНОГО ПЛАГИНА. Манифест маркетплейса нужен,
// только когда один Git-репозиторий содержит несколько плагинов (или когда
// репозиторий импортируют как маркетплейс). Тогда файл кладут В КОРЕНЬ
// РЕПОЗИТОРИЯ по пути .cursor-plugin/marketplace.json:
//
//   my-plugins/                       <- корень репозитория
//   ├── .cursor-plugin/
//   │   └── marketplace.json          <- манифест маркетплейса
//   └── plugins/                      <- metadata.pluginRoot
//       └── my-plugin/                <- плагин (содержимое этой папки-шаблона)
//           └── .cursor-plugin/
//               └── plugin.json
//
// Как использовать: скопируйте marketplace.example.json (версию без комментариев)
// в <корень репозитория>/.cursor-plugin/marketplace.json и отредактируйте.
// Файл читается как строгий JSON — комментарии в нём недопустимы.
// Весь файл манифеста должен быть не больше 10 МБ.
//
// Документация:
// https://cursor.com/docs/reference/plugins#cursor-multi-plugin-repositories
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] string. Идентификатор маркетплейса, kebab-case.
  "name": "my-marketplace",

  // [ОБЯЗАТЕЛЬНЫЙ] object. Владелец маркетплейса.
  "owner": {
    // [ОБЯЗАТЕЛЬНЫЙ] string. Имя владельца или организации.
    "name": "Ваша Организация",
    // [необязательный] string. Контактный e-mail владельца.
    "email": "plugins@example.com"
  },

  // [необязательный] object. Дополнительные сведения о маркетплейсе.
  "metadata": {
    // [необязательный] string. Описание маркетплейса.
    "description": "Набор плагинов для инструментов разработки",
    // [необязательный] string. Версия маркетплейса.
    "version": "1.0.0",
    // [необязательный] string. Префикс пути, который добавляется к source каждого
    // плагина. С "pluginRoot": "plugins" запись "source": "my-plugin" указывает
    // на папку plugins/my-plugin. Если плагины лежат прямо в корне, удалите поле.
    "pluginRoot": "plugins"
  },

  // [ОБЯЗАТЕЛЬНЫЙ] array. Список плагинов. Имена плагинов в списке должны быть
  // уникальными. Одна запись = один плагин; добавляйте новые объекты в массив.
  //
  // Как разрешается запись с "source": "my-plugin":
  //   1. Cursor ищет my-plugin/.cursor-plugin/plugin.json;
  //   2. если манифест плагина найден, он объединяется с записью маркетплейса,
  //      причём значения из plugin.json имеют приоритет;
  //   3. компоненты ищутся внутри папки плагина: по путям из манифеста, а если
  //      они не заданы — в папках по умолчанию.
  //
  // Поэтому на практике в записи достаточно name, source и description, а всё
  // остальное лучше держать в plugin.json самого плагина. Ниже перечислены все
  // поддерживаемые поля записи.
  "plugins": [
    {
      // [ОБЯЗАТЕЛЬНЫЙ] string. Идентификатор плагина, kebab-case. Должен
      // совпадать с name в plugin.json этого плагина.
      "name": "my-plugin",

      // string | object. Путь к папке плагина (относительно корня репозитория,
      // с учётом metadata.pluginRoot) либо объект с полем path и опциями.
      // В таблице документации поле не помечено как обязательное, но
      // установленный Cursor пропускает запись без source — указывайте всегда.
      "source": "my-plugin",

      // [необязательный] string. Описание плагина.
      "description": "Краткое описание того, что делает плагин",

      // [необязательный] string. Версия плагина в формате semver.
      "version": "1.0.0",

      // [необязательный] object. Сведения об авторе плагина.
      "author": {
        // [ОБЯЗАТЕЛЬНЫЙ, если указан объект author] string. Имя автора.
        "name": "Ваше Имя",
        // [необязательный] string. E-mail автора.
        "email": "you@example.com"
      },

      // [необязательный] string. URL домашней страницы плагина.
      "homepage": "https://example.com/my-plugin",

      // [необязательный] string. URL репозитория плагина.
      "repository": "https://github.com/your-org/my-plugin",

      // [необязательный] string. Идентификатор лицензии.
      "license": "MIT",

      // [необязательный] array of string. Теги для поиска.
      "keywords": ["cursor", "plugin", "template"],

      // [необязательный] string. Относительный путь к логотипу или URL.
      "logo": "assets/logo.svg",

      // [необязательный] string. Категория плагина. Есть только в записи
      // маркетплейса (в plugin.json такого поля нет).
      "category": "developer-tools",

      // [необязательный] array of string. Дополнительные теги. Есть только
      // в записи маркетплейса.
      "tags": ["code-review", "security"],

      // [необязательный] string | array of string. Путь(и) к папкам навыков.
      "skills": "./skills/",

      // [необязательный] string | array of string. Путь(и) к файлам или папкам правил.
      "rules": "./rules/",

      // [необязательный] string | array of string. Путь(и) к файлам или папкам агентов.
      "agents": "./agents/",

      // [необязательный] string | array of string. Путь(и) к файлам или папкам команд.
      "commands": "./commands/",

      // [необязательный] string | object. Путь к конфигурации хуков или встроенная
      // конфигурация хуков.
      "hooks": "./hooks/hooks.json",

      // [необязательный] string | object. Путь к конфигурации MCP или встроенная
      // конфигурация MCP-серверов.
      "mcpServers": "./mcp.json",

      // [необязательный] object. JSON Schema с объявлением переменных плагина
      // (значения задаются в дашборде: Plugins → Configure). Предпочтительно
      // объявлять переменные в plugin.json; если заданы оба, приоритет у
      // манифеста плагина. Формат и допустимые ключевые слова — те же, что
      // у поля variables в plugin.json (см. plugin.annotated.jsonc).
      "variables": {
        // [ОБЯЗАТЕЛЬНЫЙ, если указан variables] Верхний уровень схемы — объект.
        "type": "object",
        // [ОБЯЗАТЕЛЬНЫЙ, если указан variables] object. Объявления переменных.
        "properties": {
          // Имя переменной (оно же имя плейсхолдера ${API_TOKEN}) и её схема.
          "API_TOKEN": {
            // [необязательный] Тип значения переменной.
            "type": "string",
            // [необязательный] string. Заголовок поля в форме настройки.
            "title": "API-токен",
            // [необязательный] string. Пояснение к полю.
            "description": "Bearer-токен для HTTP MCP-сервера example-api"
          }
        },
        // [необязательный] array of string. Имена обязательных переменных.
        "required": ["API_TOKEN"]
      }
    }
  ]
}
