// =============================================================================
// АННОТИРОВАННАЯ КОПИЯ ФАЙЛА hooks/hooks.json
//
// Cursor читает hooks.json как строгий JSON, комментарии в нём недопустимы.
// Рабочая конфигурация лежит рядом (hooks.json), здесь — те же параметры
// с пояснениями. Cursor этот файл не читает; перед публикацией его можно удалить.
//
// Документация:
//   https://cursor.com/docs/reference/plugins#hooks-format
//   https://cursor.com/docs/hooks
//
// ВАЖНО: В ШАБЛОНЕ ПОДКЛЮЧЕНЫ ВСЕ 21 СОБЫТИЕ, ЧТОБЫ ПОКАЗАТЬ ПОЛНЫЙ СПИСОК.
// В настоящем плагине оставьте только нужные: каждый хук — это отдельный
// процесс, который запускается при каждом срабатывании события.
//
// -----------------------------------------------------------------------------
// ПАРАМЕТРЫ ОДНОГО ХУКА (объекта внутри массива события)
// -----------------------------------------------------------------------------
//   command     [ОБЯЗАТЕЛЬНЫЙ] string. Путь к скрипту или shell-команда.
//   type        [необязательный] "command" | "prompt". По умолчанию "command".
//               Хуки из плагинов выполняются ТОЛЬКО как command; тип "prompt"
//               (проверка условия языковой моделью, с полями prompt и model)
//               доступен в проектных и пользовательских hooks.json, но не
//               в плагинах.
//   timeout     [необязательный] number. Тайм-аут выполнения в секундах.
//               По умолчанию — значение платформы.
//   loop_limit  [необязательный] number | null. Только для stop и subagentStop:
//               сколько раз подряд хук может автоматически продолжить работу
//               через followup_message. По умолчанию 5; null — без ограничения.
//   failClosed  [необязательный] boolean. По умолчанию false. При true сбой хука
//               (падение, тайм-аут, ненулевой код выхода, отсутствие вывода)
//               БЛОКИРУЕТ действие, а не пропускает его. Полезно для хуков,
//               критичных для безопасности.
//   matcher     [необязательный] string. Регулярное выражение, которое решает,
//               запускать ли хук. Пустая строка или "*" — запускать всегда.
//               С чем сравнивается выражение, зависит от события (см. ниже).
//
// -----------------------------------------------------------------------------
// КАК ХУК ОБЩАЕТСЯ С CURSOR
// -----------------------------------------------------------------------------
//   Вход:  JSON в stdin. Выход: JSON в stdout.
//   Код выхода 0   — успех, используется JSON из stdout.
//   Код выхода 2   — заблокировать действие (то же, что "permission": "deny").
//   Другие коды    — хук считается упавшим, действие выполняется (fail-open),
//                    если не задан failClosed: true.
//   Для хуков-разрешений (preToolUse, subagentStart, beforeShellExecution,
//   beforeMCPExecution, beforeReadFile, beforeTabFileRead) невалидный JSON или
//   ответ не по схеме блокирует действие даже при failClosed: false.
//
// -----------------------------------------------------------------------------
// ПУТИ К СКРИПТАМ
// -----------------------------------------------------------------------------
//   Хуки плагина запускаются из папки установки плагина (на неё указывает
//   CURSOR_PLUGIN_ROOT), поэтому работает относительный путь "./scripts/...".
//   Исключение: stop и subagentStop запускаются из корня рабочей области —
//   для них путь задан через ${CURSOR_PLUGIN_ROOT}.
// =============================================================================
{
  // [ОБЯЗАТЕЛЬНЫЙ] number. Версия схемы конфигурации: положительное целое,
  // используйте 1. В общей документации по хукам параметр помечен обязательным;
  // примеры для плагинов в Plugins reference его опускают — надёжнее указывать.
  "version": 1,

  // [ОБЯЗАТЕЛЬНЫЙ] object. Соответствие «имя события → массив хуков».
  // Каждое событие необязательно: перечисляйте только те, что нужны плагину.
  // Для одного события можно задать несколько хуков — выполнятся все.
  "hooks": {
    // =========================================================================
    // ХУКИ АГЕНТА (срабатывают во время сессии агента)
    // =========================================================================

    // [необязательное событие] Создан новый диалог. Хук не блокирует работу:
    // агент не ждёт ответа. Может вернуть env (переменные окружения для всех
    // следующих хуков сессии) и additional_context (текст в начальный контекст).
    // В облачных агентах не выполняется.
    "sessionStart": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ],

    // [необязательное событие] Диалог завершён. Для логов, аналитики и очистки;
    // ответ хука не используется. В облачных агентах не выполняется.
    "sessionEnd": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ],

    // [необязательное событие] Перед вызовом ЛЮБОГО инструмента (Shell, Read,
    // Write, MCP, Task и др.). Ответ: permission ("allow" | "deny"), user_message,
    // agent_message, updated_input (изменённые аргументы инструмента).
    "preToolUse": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/permission-hook.sh",
        // [необязательный] Сравнивается с типом инструмента: Shell, Read, Write,
        // Grep, Delete, Task, а для MCP-инструментов — "MCP:<имя_инструмента>".
        "matcher": "Shell|Read|Write"
      }
    ],

    // [необязательное событие] После успешного вызова инструмента. Для аудита и
    // аналитики. Ответ: additional_context (текст в диалог после результата),
    // updated_mcp_tool_output (только для MCP: заменяет вывод инструмента).
    // matcher — по типу инструмента, как у preToolUse.
    "postToolUse": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ],

    // [необязательное событие] Инструмент завершился ошибкой, по тайм-ауту или
    // был запрещён. Ответ: additional_context. matcher — по типу инструмента.
    "postToolUseFailure": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ],

    // [необязательное событие] Перед запуском субагента (инструмент Task).
    // Ответ: permission ("allow" | "deny"; "ask" не поддерживается и считается
    // запретом), user_message.
    "subagentStart": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/permission-hook.sh",
        // [необязательный] Сравнивается с типом субагента: generalPurpose,
        // explore, shell и т. д.
        "matcher": "explore|shell"
      }
    ],

    // [необязательное событие] Субагент завершился, упал или был прерван.
    // Ответ: followup_message — текст, с которым субагент автоматически
    // продолжит работу (учитывается только при status "completed").
    // matcher — по типу субагента.
    "subagentStop": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука. Путь задан через
        // ${CURSOR_PLUGIN_ROOT}: subagentStop запускается из корня рабочей
        // области, а не из папки плагина.
        "command": "${CURSOR_PLUGIN_ROOT}/scripts/observe-hook.sh",
        // [необязательный] Лимит автоматических продолжений через
        // followup_message. По умолчанию 5; null — без ограничения.
        "loop_limit": 5
      }
    ],

    // [необязательное событие] Перед выполнением shell-команды.
    // Ответ: permission ("allow" | "deny" | "ask"), user_message, agent_message.
    // Этот хук показывает все параметры, применимые к обычному событию.
    "beforeShellExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/permission-hook.sh",
        // [необязательный] Тип выполнения. По умолчанию "command"; в плагинах
        // поддерживается только он.
        "type": "command",
        // [необязательный] Тайм-аут в секундах. По умолчанию — значение платформы.
        "timeout": 30,
        // [необязательный] false (по умолчанию) — при сбое хука команда всё равно
        // выполнится; true — при сбое хука команда будет заблокирована.
        "failClosed": false,
        // [необязательный] Сравнивается с полным текстом shell-команды. Здесь хук
        // запускается, только если в команде встречается rm, curl или wget.
        "matcher": "rm|curl|wget"
      }
    ],

    // [необязательное событие] После выполнения shell-команды. Для аудита и
    // сбора метрик; на вход приходят команда, её вывод и длительность.
    // matcher — по тексту команды.
    "afterShellExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ],

    // [необязательное событие] Перед вызовом MCP-инструмента.
    // Ответ: permission ("allow" | "deny" | "ask"), user_message, agent_message.
    // В облачных агентах не выполняется.
    "beforeMCPExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/permission-hook.sh",
        // [необязательный] Для хуков beforeMCPExecution, критичных для
        // безопасности, документация рекомендует true. В шаблоне оставлено
        // безопасное значение по умолчанию.
        "failClosed": false
      }
    ],

    // [необязательное событие] После вызова MCP-инструмента. На вход приходят
    // параметры инструмента и полный JSON-результат.
    // В облачных агентах не выполняется.
    "afterMCPExecution": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ],

    // [необязательное событие] Перед чтением файла агентом. Для контроля доступа:
    // можно не пустить чувствительный файл в модель.
    // Ответ: permission ("allow" | "deny"), user_message.
    // matcher сравнивается со значением "Read".
    "beforeReadFile": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/permission-hook.sh",
        // [необязательный] При true сбой хука блокирует чтение файла.
        "failClosed": false
      }
    ],

    // [необязательное событие] После правки файла агентом. Для форматтеров и
    // учёта кода, написанного агентом. matcher сравнивается со значением "Write".
    "afterFileEdit": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ],

    // [необязательное событие] Пользователь нажал «отправить», запрос ещё не
    // ушёл. Ответ: continue (boolean — пропустить ли промпт), user_message.
    // matcher сравнивается со значением "UserPromptSubmit".
    "beforeSubmitPrompt": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/before-submit-prompt-hook.sh"
      }
    ],

    // [необязательное событие] Перед сжатием (суммаризацией) контекста. Только
    // наблюдение: заблокировать или изменить сжатие нельзя.
    // Ответ: user_message — сообщение пользователю.
    "preCompact": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ],

    // [необязательное событие] Цикл агента завершился. Ответ: followup_message —
    // если задан и не пуст, Cursor отправит его как следующее сообщение
    // пользователя (циклы «повторять до достижения цели»).
    // matcher сравнивается со значением "Stop".
    // Этот хук показывает все параметры, применимые к stop и subagentStop.
    "stop": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука. Путь задан через
        // ${CURSOR_PLUGIN_ROOT}: stop запускается из корня рабочей области,
        // а не из папки плагина.
        "command": "${CURSOR_PLUGIN_ROOT}/scripts/observe-hook.sh",
        // [необязательный] Тип выполнения. По умолчанию "command".
        "type": "command",
        // [необязательный] Тайм-аут в секундах.
        "timeout": 30,
        // [необязательный] Лимит автоматических продолжений через
        // followup_message. По умолчанию 5; null — без ограничения.
        "loop_limit": 5,
        // [необязательный] При true сбой хука считается блокирующим.
        "failClosed": false
      }
    ],

    // [необязательное событие] Агент завершил ответное сообщение; на вход
    // приходит его текст. matcher сравнивается со значением "AgentResponse".
    "afterAgentResponse": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ],

    // [необязательное событие] Агент завершил блок размышлений; на вход приходит
    // его текст. matcher сравнивается со значением "AgentThought".
    "afterAgentThought": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ],

    // =========================================================================
    // ХУКИ TAB (срабатывают для автодополнения Tab, а не для агента)
    // В облачных агентах не выполняются.
    // =========================================================================

    // [необязательное событие] Перед чтением файла функцией Tab. Для контроля
    // доступа и скрытия секретов. Ответ: permission ("allow" | "deny").
    // matcher сравнивается со значением "TabRead".
    "beforeTabFileRead": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/permission-hook.sh"
      }
    ],

    // [необязательное событие] После правки файла функцией Tab. Для форматтеров
    // и аудита; на вход приходят подробные сведения о правке (диапазон, строка
    // до и после). matcher сравнивается со значением "TabWrite".
    "afterTabFileEdit": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ],

    // =========================================================================
    // ХУК ЖИЗНЕННОГО ЦИКЛА ПРИЛОЖЕНИЯ (срабатывает вне сессии агента)
    // В облачных агентах не выполняется.
    // =========================================================================

    // [необязательное событие] Cursor открыл рабочую область, а также при каждом
    // изменении набора её папок. Ответ: pluginPaths — абсолютные пути к папкам
    // плагинов, которые нужно загрузить для этой рабочей области.
    "workspaceOpen": [
      {
        // [ОБЯЗАТЕЛЬНЫЙ] Скрипт или команда хука.
        "command": "./scripts/observe-hook.sh"
      }
    ]
  }
}
